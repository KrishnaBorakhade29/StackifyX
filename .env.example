# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# ── MongoDB ─────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/stackifyx
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/stackifyx
MONGO_URI=mongodb://127.0.0.1:27017/stackifyx

# ── Sessions ────────────────────────────────────────────
SESSION_SECRET=change_this_to_a_long_random_string

# ── Admin account (auto-created on first boot) ─────────
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@stackifyx.com
ADMIN_PASSWORD=Admin@123456

# ── Email (choose ONE) ──────────────────────────────────
# Option A: Gmail SMTP (works locally; blocked on Render free tier)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=StackifyX <your_gmail@gmail.com>

# Option B: Brevo HTTP API (works everywhere, incl. Render)
BREVO_API_KEY=
BREVO_SENDER_NAME=StackifyX
BREVO_SENDER_EMAIL=your_verified_sender@example.com

# ── Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
